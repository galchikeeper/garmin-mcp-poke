# Encrypted state persistence. Use a dedicated classic PAT with gist scope only.
GIST_ID=
GITHUB_TOKEN=
TOKEN_ENCRYPTION_KEY=

# Read-only bootstrap seed. Legacy GARMINTOKENS_BASE64 is also accepted.
GARMIN_TOKENS_BASE64=

# LOCAL seed script only. The server never uses these values for login.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Server config (set by Render automatically)
PORT=8000
HOST=0.0.0.0
