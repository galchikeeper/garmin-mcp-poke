# Directory containing refreshed tokens and request_guard.json.
# Local default: ~/.garmin-mcp. On Render this MUST be on a persistent disk.
GARMIN_STATE_DIR=
# One-time seed only; saved, refreshed tokens always take precedence.
# Render Secret File example: /etc/secrets/garmin_tokens.json
GARMIN_TOKEN_SOURCE=
# Alternative seed: JSON from the local token file (never commit it).
GARMIN_TOKENS_JSON=
GARMIN_RATE_LIMIT_COOLDOWN_SEC=1800
PORT=8000
HOST=0.0.0.0
